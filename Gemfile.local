# frozen_string_literal: true

source 'https://rubygems.org'

gemspec

gem 'robot_lab', path: '../robot_lab'

group :development, :test do
  gem 'aigcm'
  gem 'debug_me'
  gem 'flay'
  gem 'flog'
  gem 'minitest', '~> 5.16'
  gem 'minitest-reporters'
  gem 'rake', '~> 13.0'
  gem 'rubocop'
  gem 'simplecov'
end
